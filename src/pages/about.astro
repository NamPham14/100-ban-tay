---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dự Án | 100 Bàn Tay Dựng Xây" description="Tôn vinh những người hùng thầm lặng của ngành xây dựng Việt Nam qua 100 câu chuyện và 100 bức ảnh bàn tay thật.">
  <main class="min-h-[100dvh] bg-[#101518] text-[#DDE1E6] flex flex-col relative pb-safe overflow-hidden">
    
    {/* Background ambient glow */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gradient-to-tr from-[#532DA3]/20 via-[#179FE8]/10 to-transparent rounded-full blur-[120px] pointer-events-none"></div>

    <div class="flex-1 flex items-center justify-center px-6 py-28 md:py-36 relative z-10">
      <div class="max-w-4xl w-full">
        
        {/* Cyber Editorial header */}
        <div class="mb-14 md:mb-20 border-b border-[#272A6E] pb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#272A6E]/50 border border-[#6E2BDB]/40 text-[#179FE8] text-[10px] font-bold uppercase tracking-[0.2em] mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-[#179FE8] animate-pulse"></span>
            Visionary Exhibition Project
          </div>
          
          <h1 class="font-heading text-5xl sm:text-7xl md:text-8xl font-bold text-[#DDE1E6] leading-[0.9] tracking-tighter uppercase mb-6">
            100 Bàn Tay<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#6E2BDB] via-[#179FE8] to-[#0C6ED9] drop-shadow-[0_0_30px_rgba(110,43,219,0.4)]">
              Dựng Xây.
            </span>
          </h1>
          
          <p class="text-base md:text-lg text-zinc-300 max-w-xl font-light leading-relaxed">
            Dự án triển lãm số lưu trữ những câu chuyện đời thường của người thợ xây dựng Việt Nam. Mộc mạc, thô ráp, và nguyên bản dưới góc nhìn công nghệ tương lai.
          </p>
        </div>

        {/* Key Project Stats Cube */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14 md:mb-20">
          <div class="bg-[#181f24]/80 border border-[#272A6E] p-6 relative group hover:border-[#179FE8] transition-all">
            <div class="text-[10px] uppercase tracking-widest text-[#179FE8] font-bold mb-2">Quy mô</div>
            <div class="font-heading text-4xl md:text-5xl font-bold text-[#DDE1E6]">100</div>
            <div class="text-xs text-zinc-400 mt-1">Bàn tay lao động</div>
          </div>
          <div class="bg-[#181f24]/80 border border-[#272A6E] p-6 relative group hover:border-[#6E2BDB] transition-all">
            <div class="text-[10px] uppercase tracking-widest text-[#6E2BDB] font-bold mb-2">Bản đồ</div>
            <div class="font-heading text-4xl md:text-5xl font-bold text-[#DDE1E6]">01</div>
            <div class="text-xs text-zinc-400 mt-1">Hình chữ S Việt Nam</div>
          </div>
          <div class="bg-[#181f24]/80 border border-[#272A6E] p-6 relative group hover:border-[#179FE8] transition-all">
            <div class="text-[10px] uppercase tracking-widest text-[#179FE8] font-bold mb-2">Trải nghiệm</div>
            <div class="font-heading text-4xl md:text-5xl font-bold text-[#DDE1E6]">360°</div>
            <div class="text-xs text-zinc-400 mt-1">Triển lãm tương tác</div>
          </div>
          <div class="bg-[#181f24]/80 border border-[#272A6E] p-6 relative group hover:border-[#6E2BDB] transition-all">
            <div class="text-[10px] uppercase tracking-widest text-[#6E2BDB] font-bold mb-2">Lưu trữ</div>
            <div class="font-heading text-4xl md:text-5xl font-bold text-[#DDE1E6]">100%</div>
            <div class="text-xs text-zinc-400 mt-1">Câu chuyện thật</div>
          </div>
        </div>

        {/* Content grid */}
        <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1px_1fr] gap-10 md:gap-14 mb-14 md:mb-20">
          
          <div class="space-y-8">
            <div class="bg-[#181f24]/50 border-l-2 border-[#179FE8] pl-6 py-2">
              <div class="text-xs uppercase tracking-[0.2em] text-[#179FE8] mb-2 font-bold">01 — Ý TƯỞNG CỐT LÕI</div>
              <p class="text-sm md:text-base text-zinc-300 font-light leading-relaxed">
                Ngành xây dựng Việt Nam có hàng triệu người lao động đang từng ngày đổ mồ hôi góp sức xây nên diện mạo đất nước — từ những công trình hạ tầng lớn xuyên quốc gia đến từng căn nhà nhỏ trong ngõ hẻm.
              </p>
            </div>
            
            <div class="bg-[#181f24]/50 border-l-2 border-[#6E2BDB] pl-6 py-2">
              <div class="text-xs uppercase tracking-[0.2em] text-[#6E2BDB] mb-2 font-bold">02 — SỨ MỆNH CHIẾN DỊCH</div>
              <p class="text-sm md:text-base text-zinc-300 font-light leading-relaxed">
                Hình ảnh người thợ xây dựng trong truyền thông thường bị lãng quên hoặc mờ nhạt sau những khối bê tông vô tri. Chiến dịch <strong class="text-[#DDE1E6] font-semibold">100 Bàn Tay Dựng Xây</strong> ra đời để thay đổi góc nhìn đó, tôn vinh những người hùng thầm lặng.
              </p>
            </div>
          </div>

          <div class="hidden md:block w-[1px] bg-[#272A6E]"></div>

          <div class="flex flex-col justify-between">
            <div>
              <div class="text-xs uppercase tracking-[0.2em] text-[#179FE8] mb-6 font-bold">03 — THÔNG ĐIỆP</div>
              
              <div class="border border-[#272A6E] bg-gradient-to-b from-[#181f24] to-[#101518] p-6 md:p-8 mb-6 relative shadow-[0_0_30px_rgba(59,42,133,0.25)]">
                <svg class="w-6 h-6 text-[#6E2BDB] mb-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <p class="font-serif text-lg md:text-xl text-[#DDE1E6] italic font-medium leading-snug">
                  "Mỗi bàn tay là một cuộc đời. 100 bàn tay dựng nên hình hài Việt Nam."
                </p>
              </div>

              <div class="text-xs text-zinc-400 font-light leading-relaxed">
                100 bức ảnh bàn tay thật — mỗi bức một mảnh đời, một vùng miền, một câu chuyện — được ghép thành hình chữ S, tạo nên bản đồ Việt Nam bằng những bàn tay dựng xây.
              </div>
            </div>
          </div>
        </div>

        {/* Organization info with real Logo */}
        <div class="border border-[#272A6E] bg-[#181f24]/60 p-8 md:p-10 relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-[#6E2BDB]/10 rounded-full blur-2xl pointer-events-none"></div>
          
          <div class="text-[10px] uppercase tracking-[0.2em] text-[#179FE8] mb-6 font-bold">ĐƠN VỊ TỔ CHỨC & ĐỒNG HÀNH</div>
          
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
              <div class="w-20 h-20 bg-[#101518] border border-[#272A6E] flex items-center justify-center p-3 shrink-0 shadow-[0_0_20px_rgba(110,43,219,0.3)]">
                <img src="/logo.png" alt="Logo 100 Bàn Tay" class="w-full h-full object-contain" />
              </div>
              <div>
                <div class="font-heading text-lg md:text-xl text-[#DDE1E6] font-bold uppercase tracking-wider">Tập đoàn Xây Dựng Việt Nam</div>
                <div class="text-xs md:text-sm text-[#179FE8] font-medium mt-1">Đồng hành cùng người lao động Việt</div>
                <div class="text-xs text-zinc-400 mt-1 font-light">Dự án triển lãm nghệ thuật số 2026</div>
              </div>
            </div>
            
            <a 
              href="/" 
              class="px-6 py-3.5 bg-gradient-to-r from-[#6E2BDB] to-[#0C6ED9] text-white font-heading text-xs font-bold uppercase tracking-widest hover:opacity-90 transition-opacity shadow-[0_0_20px_rgba(23,159,232,0.4)] shrink-0 block text-center w-full sm:w-auto"
            >
              Khám Phá Bản Đồ
            </a>
          </div>
        </div>

        {/* Back link */}
        <div class="mt-12 text-center sm:text-left">
          <a 
            href="/" 
            class="inline-flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-zinc-400 hover:text-[#179FE8] transition-colors group font-semibold"
          >
            <span class="w-8 h-[1px] bg-[#272A6E] group-hover:bg-[#179FE8] transition-colors"></span>
            Quay lại trang chính
          </a>
        </div>

      </div>
    </div>
  </main>
</Layout>
