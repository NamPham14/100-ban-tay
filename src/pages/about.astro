---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dự Án | 100 Bàn Tay Dựng Xây" description="Tôn vinh những người hùng thầm lặng của ngành xây dựng Việt Nam qua 100 câu chuyện và 100 bức ảnh bàn tay thật.">
  <main className="min-h-[100dvh] bg-[#101518] text-[#DDE1E6] flex flex-col relative pb-safe">
    
    <div className="flex-1 flex items-center justify-center px-6 py-28 md:py-32">
      <div className="max-w-3xl w-full">
        
        {/* Editorial header */}
        <div className="mb-12 md:mb-16">
          <div className="w-16 h-[3px] bg-gradient-to-r from-[#6E2BDB] to-[#179FE8] mb-8 md:mb-10"></div>
          <h1 className="font-heading text-5xl sm:text-6xl md:text-8xl font-bold text-[#DDE1E6] leading-[0.9] tracking-tighter uppercase mb-4">
            100 Bàn Tay<br />
            <span className="text-[#6E2BDB] drop-shadow-[0_0_20px_rgba(110,43,219,0.3)]">Dựng Xây</span>
          </h1>
          <p className="text-sm md:text-base text-zinc-400 max-w-md font-light leading-relaxed">
            Dự án triển lãm số lưu trữ những câu chuyện đời thường của người thợ xây dựng Việt Nam. Mộc mạc, thô ráp, và nguyên bản.
          </p>
        </div>

        {/* Content grid */}
        <div className="grid grid-cols-1 md:grid-cols-[1fr_2px_1fr] gap-8 md:gap-12 mb-12 md:mb-16">
          
          <div className="space-y-6 md:space-y-8">
            <div>
              <div className="text-[10px] uppercase tracking-[0.2em] text-[#179FE8] mb-3 font-bold">Ý TƯỞNG</div>
              <p className="text-sm md:text-base text-zinc-300 font-light leading-relaxed">
                Ngành xây dựng Việt Nam có hàng triệu người lao động đang từng ngày đổ mồ hôi góp sức xây nên diện mạo đất nước — từ những công trình hạ tầng lớn xuyên quốc gia đến từng căn nhà nhỏ trong ngõ hẻm.
              </p>
            </div>
            <div>
              <div className="text-[10px] uppercase tracking-[0.2em] text-[#179FE8] mb-3 font-bold">SỨ MỆNH</div>
              <p className="text-sm md:text-base text-zinc-300 font-light leading-relaxed">
                Hình ảnh người thợ xây dựng trong truyền thông thường bị lãng quên hoặc mờ nhạt sau những khối bê tông vô tri. Chiến dịch <strong className="text-[#DDE1E6] font-semibold">100 Bàn Tay Dựng Xây</strong> ra đời để thay đổi góc nhìn đó, tôn vinh những người hùng thầm lặng.
              </p>
            </div>
          </div>

          <div className="hidden md:block w-[1px] bg-[#272A6E]"></div>

          <div>
            <div className="text-[10px] uppercase tracking-[0.2em] text-[#6E2BDB] mb-6 font-bold">CÂU CHUYỆN</div>
            
            <div className="border border-[#272A6E] bg-[#181f24] p-6 md:p-8 mb-6 relative shadow-[0_0_30px_rgba(59,42,133,0.2)]">
              <svg className="w-5 h-5 text-[#532DA3] mb-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p className="font-serif text-lg md:text-xl text-[#DDE1E6] italic font-medium leading-snug">
                "Mỗi bàn tay là một cuộc đời. 100 bàn tay dựng nên hình hài Việt Nam."
              </p>
            </div>

            <div className="text-xs text-zinc-400 font-light leading-relaxed">
              100 bức ảnh bàn tay thật — mỗi bức một mảnh đời, một vùng miền, một câu chuyện — được ghép thành hình chữ S, tạo nên bản đồ Việt Nam bằng những bàn tay dựng xây.
            </div>
          </div>
        </div>

        {/* Organization info */}
        <div className="border-t border-[#272A6E] pt-8 md:pt-10 mt-8 md:mt-10">
          <div className="text-[10px] uppercase tracking-[0.2em] text-[#179FE8] mb-4 font-bold">ĐƠN VỊ TỔ CHỨC</div>
          <div className="flex items-center gap-5">
            <div className="w-16 h-16 bg-[#181f24] border border-[#272A6E] flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(110,43,219,0.3)]">
              <span className="font-heading text-[10px] font-bold text-[#6E2BDB] uppercase tracking-widest text-center leading-tight">Đơn<br/>vị</span>
            </div>
            <div>
              <div className="font-heading text-base text-[#DDE1E6] font-semibold uppercase tracking-wider">Tập đoàn Xây Dựng Việt Nam</div>
              <div className="text-xs text-zinc-400 mt-1 font-light">Đồng hành cùng người lao động Việt</div>
            </div>
          </div>
        </div>

        {/* Back link */}
        <a 
          href="/" 
          className="inline-flex items-center gap-3 mt-12 md:mt-16 text-xs uppercase tracking-[0.2em] text-zinc-400 hover:text-[#179FE8] transition-colors group font-semibold"
        >
          <span className="w-8 h-[1px] bg-[#272A6E] group-hover:bg-[#179FE8] transition-colors"></span>
          Quay lại triển lãm
        </a>

      </div>
    </div>
  </main>
</Layout>
