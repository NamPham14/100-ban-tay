---
import Layout from '../../layouts/Layout.astro';
import Exhibition from '../../components/Exhibition.jsx';
import stories from '../../data/stories.json';

export function getStaticPaths() {
  return stories.map((story) => {
    return {
      params: { id: story.id.toString() },
      props: { story },
    };
  });
}

const { id } = Astro.params;
const { story } = Astro.props;

const title = `100 Bàn Tay Dựng Xây | Câu Chuyện Số ${String(story.id).padStart(2, '0')}: ${story.job} (${story.region})`;
const description = `"${story.quote}" — Khám phá tư liệu triển lãm thực tế của người lao động ngành xây dựng Việt Nam.`;
const image = story.image;
---

<Layout 
  title={title}
  description={description}
  image={image}
  url={`https://100-ban-tay.vercel.app/story/${id}`}
  storyId={story.id}
>
  <main>
    <Exhibition client:load stories={stories} initialStoryId={id} />
  </main>
</Layout>
